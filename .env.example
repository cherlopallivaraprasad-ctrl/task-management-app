# ============================================================
# TaskFlow Server Environment Configuration (.env)
# ============================================================

# Application Port
PORT=5000

# MongoDB Database Connection String
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskflow?retryWrites=true&w=majority

# Secret key used for signing JWT Authentication Tokens
JWT_SECRET=supersecretjwtkey_taskflow_production_ready_2026

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173
